{
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        {"key":"Cache-Control","value":"private, no-store"},
        {"key":"Content-Security-Policy","value":"frame-ancestors 'none'; object-src 'none'; base-uri 'none'"},
        {"key":"Referrer-Policy","value":"no-referrer"},
        {"key":"X-Frame-Options","value":"DENY"}
      ]
    }
  ]
}
